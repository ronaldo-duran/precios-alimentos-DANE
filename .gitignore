# Datos crudos y derivados: no se versionan (ver README para regenerarlos).
data/raw/*
data/incoming/*
data/processed/*
!data/raw/.gitkeep
!data/incoming/.gitkeep
!data/processed/.gitkeep

# EXCEPCIÓN: los logs del registro en vivo SÍ se versionan. Son la prueba de
# que un pronóstico se escribió antes de que ocurriera la semana, y el workflow
# semanal los commitea. El log en vivo crece ~35 KB/semana; el sembrado del
# backtest es estático y se commitea una sola vez.
!data/processed/forecasts_log.csv
!data/processed/alertas_log.csv
!data/processed/forecasts_backfill.csv

# EXCEPCIÓN 2: los derivados que consume la app. Streamlit Community Cloud
# despliega leyendo del repo, así que sin estos la app no arranca. Son
# procesados y pequeños (~470 KB en total), no datos crudos: `diario.parquet`
# (3,5 MB), `backtest.parquet` y `reconciliacion.csv` siguen fuera.
!data/processed/semanal.parquet
!data/processed/reporte_series.csv
!data/processed/metricas_por_horizonte.csv
!data/processed/metricas_por_serie.csv
!data/processed/cobertura_intervalos.csv
!data/processed/degradacion_por_regimen.csv
!data/processed/semanas_choque.csv
!data/processed/importancia_features.csv
!data/processed/desempeno_en_vivo.csv
!data/processed/desempeno_alertas.csv
!data/processed/alertas_reconciliadas.csv
!data/processed/busqueda_hiperparametros.csv
!data/processed/ablacion.csv
!data/processed/ablacion_por_producto.csv

# Modelos: los pesos son binarios pesados y se pueden regenerar con `make train`.
# La metadata y los diagnósticos sí se versionan: son la trazabilidad.
models/*
!models/.gitkeep
!models/latest.json
!models/*/
models/*/*.joblib

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Artefactos locales del entorno de desarrollo
.claude/launch.json
